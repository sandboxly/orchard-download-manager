{
  "manifest_version": 3,
  "name": "Orchard Download Manager",
  "short_name": "Orchard DM",
  "version": "1.0.0",
  "description": "Download links, media and the browser's own downloads with Orchard Download Manager: segmented, resumable, in your queue.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Orchard Download Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["downloads", "contextMenus", "cookies", "nativeMessaging", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
